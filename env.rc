# -*- sh -*-

SDIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
# --- Shared host-path variables (Phase 0 Step 3) ---
# Overridable at the shell: D_USER, HOME_DIR, MOUNT_ROOT, WORK_ROOT.
D_USER="${D_USER:-ed}"
HOME_DIR="${HOME_DIR:-/home/$D_USER}"
MOUNT_ROOT="${MOUNT_ROOT:-/mnt/spark}"          # host mount base (shared pkgs)
WORK_ROOT="${WORK_ROOT:-$MOUNT_ROOT/docker}"    # repo/workspace root on host

# Prevent:
# WARN SHELL is not supported for OCI image format, [/bin/bash -c] will be ignored. Must use `docker` format
export BUILDAH_FORMAT=docker

export PODMAN_USERNS=keep-id
# or create ~/.config/containers/containers.conf with:
#[containers]
#userns = "keep-id"

url=https://catalog.ngc.nvidia.com/orgs/nvidia/containers/pytorch

d_local=docker/.local
d_cache=docker/cache
d_downloads=python

d_build_extra=""
d_run_mount_extra=""

dirs_base="
pytorch-jp
jax-jp
cudadl-jp
vllm-vllm-openai
"

dirs_addons="
torchaudio
transformers
cudnn
gemma
comfyui
llamacpp
aifoundations
"

d_build() {
    set -x
    docker build $d_build_extra --progress plain $@ -t $d_image .
    set +x
}

d_build_all() {
    cd $SDIR
    for d in $dirs_base; do
	( cd $d
	  source env.rc
	  echo -e "\n=== Building $d ===\n"
	  d_0
	  # base images: common/ lives at the repo root, Dockerfile in $d;
	  # build from the repo root so `COPY common /common` resolves.
	  cd $SDIR
	  docker build $d_build_extra --progress plain $@ -f $d/Dockerfile -t $d_image .
	)
    done

    for d in $dirs_addons; do
	( cd $d
	  source env.rc
	  echo -e "\n=== Building $d ===\n"
	  d_build
	)
    done
}

d_bash() {
echo docker exec -it $d_name /usr/bin/bash
     docker exec -it $d_name /usr/bin/bash
}
d_bash0() {
echo docker exec -it --user 0 $d_name /usr/bin/bash
     docker exec -it --user 0 $d_name /usr/bin/bash
}

d_exec() {
echo docker exec -it $d_name $@
     docker exec -it $d_name $@
}
d_exec0() {
echo docker exec -it --user 0 $d_name $@
     docker exec -it --user 0 $d_name $@
}

d_pip_list_all() {
    cd $SDIR
    for d in $dirs_base $dirs_addons; do
	( cd $d
	  source env.rc
	  echo -e "\n=== $d pip list ===\n"
	  d_run_shell pip list > ../logs/pip_list.${d}.log
	)
    done
}

d_run_all() {
    cd $SDIR
    for d in $dirs_base $dirs_addons; do
	( cd $d
	  source env.rc
	  echo -e "\n=== $d $@ ===\n"
	  d_run $@
	)
    done
}

d_run() {
    # defaults to user specified in Dockerfile
    d_opts="-it --rm"

    set -x
    docker run --name $d_name $d_opts --gpus all --network host --ipc=host --ulimit memlock=-1 --ulimit stack=67108864 \
	   -v $HOME_DIR/.cache/huggingface:$HOME_DIR/.cache/huggingface \
	   -v $HOME_DIR/Downloads/$d_local:$HOME_DIR/.local \
	   -v $HOME_DIR/Downloads/$d_cache:/root/.cache \
	   -v $HOME_DIR/Downloads/$d_downloads:$HOME_DIR/Downloads/$d_downloads \
	   $d_run_mount_extra \
	   $d_image $@
    set +x
}

d_run_shell() {
    # defaults to d_run
    d_run $@
}
