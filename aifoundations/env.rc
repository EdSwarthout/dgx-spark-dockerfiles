# -*- sh -*-

source ../env.rc

d_image=aifoundations
d_name=aifoundations

# To access the course from the notebook in $d_downloads:
# git clone --depth 1 https://github.com/google-deepmind/ai-foundations.git

d_run() {
    d_opts="-it --rm --shm-size=1g"

    set -x
    docker run --name $d_name $d_opts --gpus all --network host --ulimit memlock=-1 --ulimit stack=67108864 \
	   -v $HOME_DIR/.cache/huggingface:$HOME_DIR/.cache/huggingface \
	   -v $HOME_DIR/.cache/gemma:$HOME_DIR/.cache/gemma \
	   -v $HOME_DIR/Downloads/$d_local/.local:$HOME_DIR/.local \
	   -v $HOME_DIR/Downloads/$d_cache:/root/.cache \
	   -v $HOME_DIR/Downloads/$d_downloads:$HOME_DIR/Downloads/$d_downloads \
	   -w $HOME_DIR/Downloads/$d_downloads \
	   $d_image $@
    set +x
}
