# -*- sh -*-

url1=https://build.nvidia.com/spark/vllm/agent-ready-qwen35b
url2=https://recipes.vllm.ai/Qwen/Qwen3.6-35B-A3B
url_docker=https://hub.docker.com/r/vllm/vllm-openai/tags


d_base=vllm/vllm-openai
d_base_ver=v0.31.0

# prebuilt cu134 only in nightly
#d_base_ver=cu134-nightly

# For Gemma 4 model family, use vLLM custom container:
# d_base_ver=gemma4-cu130


source ../env.rc

d_image_base=vllm-openai-user
d_image=${d_image_base}:${d_base_ver}
d_name=vllm-openai-user

# Base has vision and ao, but no audio

# User must be in /etc/passwd
#d_user=root
#d_user=ubuntu
d_user=ed

d_build_extra="--build-arg VER=$d_base_ver --build-arg USERID=$d_user"

d_0() {
    docker pull $d_base:$d_base_ver
    # there is no /root/.cache in base
}

# Uses:
# ~/.cache/huggingface
# ~/.cache/vllm

d_run() {
    d_image=${d_base}:${d_base_ver}

    # defaults to user specified in Dockerfile
    d_opts="-it --rm"
#   d_opts="--restart=unless-stopped"

    set -x
    docker run --name $d_name $d_opts --gpus all --network host --ipc=host --ulimit memlock=-1 --ulimit stack=67108864 --shm-size=16g \
	-v $HOME_DIR/.cache/huggingface:$HOME_DIR/.cache/huggingface \
	-v $HOME_DIR/.cache/vllm:$HOME_DIR/.cache/vllm \
	-v $HOME_DIR/Downloads/$d_local/.local:$HOME_DIR/.local \
	-v $HOME_DIR/Downloads/$d_cache:/root/.cache \
	-v $HOME_DIR/Downloads/$d_downloads:$HOME_DIR/Downloads/$d_downloads \
	-w $HOME_DIR/Downloads/$d_downloads \
	$d_run_mount_extra \
	--env="HF_TOKEN=$HF_TOKEN" \
	$d_image $vllm_serve_args
    set +x
}

d_run_root() {
    (
	d_run_mount_extra="$d_run_mount_extra --user 0"
	d_run
    )
}

d_run_shell() {
    # d_run_shell bash or python3
    (
	d_run_mount_extra="$d_run_mount_extra --entrypoint="" --user 0"
	vllm_serve_args="$@"
	d_run
    )
}



d_run0() {
    d_image=${d_base}:${d_base_ver}
    d_name=vllm-openai0
    d_user=ubuntu

    d_opts="-it --rm"

    # default entrypoint is "vllm serve"
    docker run --name $d_name $d_opts --gpus all --network host --ipc=host --ulimit memlock=-1 --ulimit stack=67108864 \
	--entrypoint="" \
	$d_image $@
}

# Recipes

# https://huggingface.co/nvidia/Qwen3.6-35B-A3B-NVFP4
# https://recipes.vllm.ai/Qwen/Qwen3.6-35B-A3B?hardware=dgx_spark_gb10
#Smaller Qwen3.6 multimodal MoE model (35B total / 3B active) with BF16, FP8, and NVIDIA NVFP4 variants
vllm_serve_args_Qwen36_35B='''
nvidia/Qwen3.6-35B-A3B-NVFP4
  --host 0.0.0.0
  --port 8000
  --tensor-parallel-size 1
  --trust-remote-code
  --kv-cache-dtype fp8
  --attention-backend flashinfer
  --moe-backend marlin
  --gpu-memory-utilization 0.4
  --max-model-len 262144
  --max-num-seqs 4
  --max-num-batched-tokens 8192
  --enable-chunked-prefill
  --async-scheduling
  --enable-prefix-caching
  --speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":3,\"moe_backend\":\"triton\"}'
  --load-format fastsafetensors
  --reasoning-parser qwen3
  --tool-call-parser qwen3_xml
  --enable-auto-tool-choice
'''

# Free memory on device (113.73/121.69 GiB) on startup. Desired GPU memory utilization is (0.4, 48.68 GiB).
# Actual usage is 26.08 GiB for consumed memory (weights + non-torch), 3.81 GiB for peak activation, and 0.18 GiB for CUDAGraph memory.
# Replace gpu_memory_utilization config with `--kv-cache-memory=19812958925` (18.45 GiB) to fit into requested memory, or `--kv-cache-memory=89667098112` (83.51 GiB) to fully utilize gpu memory.
# Current kv cache memory in use is 18.78 GiB

# --mm-encoder-tp-mode data -- switches the multi-modal vision encoder (such as a ViT) from tensor parallelism (TP) to batch-level data parallelism (DP). Most impactful when running multimodal models with tensor parallelism ≥ 4
# --moe-backend marlin
# --max-num-batched-tokens -- Maximum number of tokens that can be processed in a single iteration
# --max-num-seqs -- Maximum number of sequences to be processed in a single iteration.

vllm_serve_args="$vllm_serve_args_Qwen36_35B"

# https://huggingface.co/nvidia/Qwen3.8-27B-NVFP4
# https://recipes.vllm.ai/Qwen/Qwen3.8-27B?features=tool_calling%2Creasoning%2Cencoder_parallel%2Cspec_decoding&variant=nvfp4_nvidia

vllm_serve_args_Qwen38_27B='''
nvidia/Qwen3.8-27B-NVFP4
  --host 0.0.0.0
  --port 8000
  --tensor-parallel-size 1
  --trust-remote-code
  --kv-cache-dtype fp8
  --moe-backend marlin
  --gpu-memory-utilization 0.7
  --max-model-len 262144
  --max-num-seqs 4
  --max-num-batched-tokens 8192
  --enable-chunked-prefill
  --async-scheduling
  --enable-prefix-caching
  --speculative-config '{\"method\":\"mtp\",\"num_speculative_tokens\":5}'
  --load-format fastsafetensors
  --reasoning-parser qwen3
  --tool-call-parser qwen3_xml
  --enable-auto-tool-choice
'''

# --attention-backend flashinfer

vllm_serve_args="$vllm_serve_args_Qwen38_27B"


# https://huggingface.co/nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
# hf download nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4

#WEIGHTS=/path/to/nemotron-3-nano-omni-weights

vllm_serve_args_nemotron_3_nano_omni='''
nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
  --served-model-name=nemotron_3_nano_omni
  --max-num-seqs 8
  --max-model-len 131072
  --host 0.0.0.0
  --port 8000
  --trust-remote-code
  --gpu-memory-utilization 0.8
  --limit-mm-per-prompt '{\"video\":1,\"image\":1,\"audio\":1}'
  --media-io-kwargs '{\"video\":{\"fps\":2,\"num_frames\":256}}'
  --allowed-local-media-path=/
  --enable-prefix-caching
  --max-num-batched-tokens 32768
  --reasoning-parser nemotron_v3
  --enable-auto-tool-choice
  --tool-call-parser qwen3_coder
'''

# If OOM:
#  --gpu-memory-utilization=0.70
#  --max-model-len=32768

#vllm_serve_args=$vllm_serve_args_nemotron_3_nano_omni


gtp=$(find $HOME_DIR/.cache/huggingface/hub -name granite_thinking_parser.py)

vllm_serve_args_granite42="ibm-granite/granite-4.2-8b \
    --host 0.0.0.0 \
    --port 8000 \
    --trust-remote-code \
    --gpu-memory-utilization 0.8 \
    --served-model-name granite-4.2-8b \
    --dtype bfloat16 \
    --max-model-len 131072 \
    --reasoning-parser granite_thinking_parser \
    --reasoning-parser-plugin $gtp \
    --tool-call-parser qwen3_coder \
    --enable-auto-tool-choice
"
#vllm_serve_args=$vllm_serve_args_granite42
