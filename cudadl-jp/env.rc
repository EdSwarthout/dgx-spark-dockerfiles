# -*- sh -*-

url=https://catalog.ngc.nvidia.com/orgs/nvidia/containers/cuda-dl-base
d_base=nvcr.io/nvidia/cuda-dl-base

# Introduction to cuDNN Frontend Python API:
# https://github.com/NVIDIA/cudnn-frontend/blob/main/samples/python/00_introduction.ipynb
# Use CuPy instead of torch

# Four variants:
# Minimal inference runtime with stub libraries
d_base_variant1=inference-runtime
# contains inference-runtime layers and adds 4 layers
d_base_variant2=inference-devel
# Full CUDA runtime libraries
d_base_variant3=runtime
# Full development environment
d_base_variant4=devel

d_base_ver=26.07-cuda13.3-${d_base_variant4}-ubuntu24.04

source ../env.rc

d_image=cuda-dl-base
d_name=cuda-dl

# user must be in /etc/passwd
#d_user=root
#d_user=ubuntu
d_user=ed

d_build_extra="--build-arg VER=$d_base_ver --build-arg USERID=$d_user"

d_0() {
    docker pull $d_base:$d_base_ver
}

d_run0() {
    d_image=${d_base}:${d_base_ver}
    d_name=cuda-dl0
    d_user=ubuntu

    d_opts="-it --rm --user=$d_user:$d_user"

    docker run --name $d_name $d_opts --gpus all --network host --ipc=host --ulimit memlock=-1 --ulimit stack=67108864 \
	   $d_image $@
}
