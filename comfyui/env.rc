# -*- sh -*-

source ../env.rc

CDIR=$HOME_DIR/Downloads/ComfyUI
DDIR=$SDIR/comfyui


d_image=comfyui
d_name=comfyui

d_run_mount_extra="$d_run_mount_extra -v $CDIR/ComfyUI:$CDIR/ComfyUI"

gitupd1() {
    (
	SDIR=$CDIR

	source $CDIR/env.rc
	gitupd
    )
}

RUNENV="ComfyUI"
d_req_diff() {
    ( cd $DDIR
      if diff -u requirements.txt $CDIR/$RUNENV/requirements.txt; then
	  echo "No requirements.txt changes"
      fi
      if diff -u manager_requirements.txt $CDIR/$RUNENV/manager_requirements.txt; then
	  echo "No manager_requirements.txt changes"
      fi
    )
}
