# -*- sh -*-

url=https://catalog.ngc.nvidia.com/orgs/nvidia/containers/jax/
d_base=nvcr.io/nvidia/jax
d_base_ver=26.07-py3

source ../env.rc

d_image=jax-jp
d_name=jax-jp


# user must be in /etc/passwd
#d_user=root
#d_user=ubuntu
d_user=ed

d_build_extra="--build-arg VER=$d_base_ver --build-arg USERID=$d_user"


d_0() {
    docker pull $d_base:$d_base_ver
    # there is no /root/.cache in base
}

d_run() {
    # defaults to user specified in Dockerfile
    d_opts="-it --rm"

    set -x
    docker run --name $d_name $d_opts --gpus all --network host --ipc=host --ulimit memlock=-1 --ulimit stack=67108864 \
	   -v $HOME_DIR/.cache/huggingface:$HOME_DIR/.cache/huggingface \
	   -v $HOME_DIR/Downloads/$d_local/.local:$HOME_DIR/.local \
	   -v $HOME_DIR/Downloads/$d_cache:/root/.cache \
	   -v $HOME_DIR/Downloads/$d_downloads:$HOME_DIR/Downloads/$d_downloads \
	   -w $HOME_DIR/Downloads/$d_downloads \
	   $d_image $@
    set +x
}

d_run0() {
    d_image=${d_base}:${d_base_ver}
    d_name=jax0
    d_user=ubuntu

    d_opts="-it --rm --user=$d_user:$d_user"

    docker run --name $d_name $d_opts --gpus all --network host --ipc=host --ulimit memlock=-1 --ulimit stack=67108864 \
	   $d_image $@
}
